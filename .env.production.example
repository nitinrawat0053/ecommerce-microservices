# ─────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to `.env.production` and fill in real values:
#   cp .env.production.example .env.production
# WARNING: Never commit .env.production to git (contains secrets).
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
LOAD_TEST=false

# Ports (internal to the Docker network — service-to-service uses hostnames)
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PRODUCT_SERVICE_PORT=3003
ORDER_SERVICE_PORT=3004
CART_SERVICE_PORT=3005
REDIS_PORT=6379

# ── Secrets ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_STRONG_SECRET

# ── Service URLs (hostnames resolve inside Docker network) ─
# Only override if you change the compose aliases.
USER_SERVICE_URL=http://user-service:3002
PRODUCT_SERVICE_URL=http://product-service:3003
ORDER_SERVICE_URL=http://order-service:3004

# ── RabbitMQ (comes up as service "rabbitmq") ─────────────
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# ── Redis (service "redis") ───────────────────────────────
REDIS_URL=redis://redis:6379

# ── MongoDB Atlas (unchanged — cloud hosted) ──────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXX

# ── SMS / WhatsApp (Twilio) ───────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX
RAZORPAY_WEBHOOK_SECRET=XXXX

# ── Image uploads (Cloudinary) ────────────────────────────
CLOUDINARY_CLOUD_NAME=yourcloud
CLOUDINARY_API_KEY=123456
CLOUDINARY_API_SECRET=XXXX

# ── Super Admin (created on first startup) ────────────────
SUPER_ADMIN_EMAIL=admin@shopmicro.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+1234567890
